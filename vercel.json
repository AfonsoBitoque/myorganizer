{
  "rewrites": [
    { "source": "/((?!api|assets|sw\\.js|workbox-.*\\.js|manifest\\.webmanifest|.*\\.(?:png|svg|ico|js|css|woff2)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
